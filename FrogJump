//TABULATION
    int minCost(vector<int>& height) {
        // Code here
        int n = height.size();
        vector<int> dp(n,0);
        for(int i=n-2;i>=0;i--){
            int c1 = dp[i+1]+abs(height[i+1]-height[i]);
            int c2 = INT_MAX;
            if(i+2<n){
                c2 = dp[i+2] + abs(height[i]-height[i+2]);
            }
            dp[i] = min(c1,c2);
            }
            return dp[0];
            
        }
